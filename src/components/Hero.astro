---
import Icon from './Icon.astro';
import TestRun from './TestRun.astro';
import { coreStack, links } from '../data/profile';
import Logo from './Logo.astro';
import Socials from './Socials.astro';
---
<div class="hero" id="top">
  <div class="wrap">
    <p class="kicker">QA ENGINEER / SDET · PARIS</p>
    <div class="grid">
      <h1>Testing like a <em>developer</em>.<br />Seeing like a <em>designer</em>.</h1>
    </div>
    <div class="grid hero-foot">
      <div class="intro">
        <p>I build <strong>Playwright test automation</strong> that catches what users actually notice: broken flows, visual regressions, accessibility gaps. Seven years in design, five in code, now in quality.</p>
        <div class="cta">
          <a class="btn primary" href="#work">See the work ↓</a>
          {links.cv && <a class="btn" href={links.cv} download><Icon name="download" />Download CV</a>}
          <Socials cv={false} />
        </div>
      </div>
      <TestRun />
    </div>
    <div class="toolbox">
      <span class="lbl">Core stack</span>
      {coreStack.map((t) => <span class="t"><Logo tech={t} />{t.label}</span>)}
    </div>
  </div>
</div>

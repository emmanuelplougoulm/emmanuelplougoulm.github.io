---
import * as icons from 'simple-icons';
import Icon from './Icon.astro';
import { links, cvFile } from '../data/profile';
import { getLang, ui } from '../i18n';
const lang = getLang(Astro.currentLocale);
const t = ui[lang].socials;
interface Props { size?: 'sm' | 'md'; cv?: boolean }
const { size = 'md', cv = true } = Astro.props;
const gh = (icons as Record<string, { path: string }>).siGithub;
---
<ul class:list={['socials', size]} aria-label={t.label}>
  <li><a href={links.linkedin} aria-label={t.linkedin} title="LinkedIn"><Icon name="linkedin" /></a></li>
  <li><a href={links.github} aria-label={t.github} title="GitHub"><svg class="i fill" viewBox="0 0 24 24" aria-hidden="true"><path d={gh.path} /></svg></a></li>
  {links.email && <li><a href={`mailto:${links.email}`} aria-label={t.email} title={t.email}><Icon name="mail" /></a></li>}
  {cv && <li><a href={cvFile[lang]} download aria-label={ui[lang].header.cvLabel} title="CV (PDF)"><Icon name="download" /></a></li>}
</ul>

---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { getProfile } from '../data/profile';
import { getExperiments } from '../data/lab';
import { getLang, localePath, ui } from '../i18n';
const lang = getLang(Astro.currentLocale);
const t = ui[lang].work;
const { projects } = getProfile(lang);
const experiments = getExperiments(lang);
// Trois chiffres courts, tirés des résultats des expériences 01, 02 et 04 (voir src/data/lab.ts).
const highlights = [experiments[0].figures[1].value, experiments[1].figures[1].value, '10 vs 1'].map((value, i) => ({ value, label: t.labStats[i] }));
---
<section id="work">
  <div class="wrap">
    <SectionHead num="03" slug="work" icon="box" intro={t.intro}>
      {t.title[0]}<em>{t.title[1]}</em>{t.title[2]}
    </SectionHead>
    <div class="work">
      <a class="card feature" href={localePath(lang, '/lab/')}>
        <div>
          <div class="card-top"><span class="badge"><span>lab</span><span>{t.labBadge(experiments.length)}</span></span><Icon name="pixel" /></div>
          <h3 style="margin-top:12px">{t.labTitle}</h3>
          <p style="margin-top:10px">{t.labText}</p>
          <div class="chips" style="margin-top:16px">{['Playwright', 'TypeScript', 'Fixtures', 'Docker', 'GitHub Actions'].map((s) => <span class="chip">{s}</span>)}</div>
          <span class="more" style="margin-top:20px">{t.labMore} <Icon name="arrow" /></span>
        </div>
        <div>
          <div class="stats">
            {highlights.map((f) => <div><b>{f.value}</b><span>{f.label}</span></div>)}
          </div>
          <dl class="meta" style="margin-top:18px">
            {experiments.map((e) => <><dt>{e.num}</dt><dd>{e.title}</dd></>)}
          </dl>
          <p class="policy">{t.labPolicy}</p>
        </div>
      </a>
      {projects.map((p) => (
        <a class="card half" href={p.url}>
          <div class="card-top"><span class="badge"><span>{p.badge[0]}</span><span>{p.badge[1]}</span></span>{p.icon && <Icon name={p.icon} />}</div>
          <h3>{p.title}</h3>
          <p>{p.description}</p>
          <div class="chips">{p.stack.map((s) => <span class="chip">{s}</span>)}</div>
          <span class="more">{p.linkLabel} <Icon name="arrow" /></span>
        </a>
      ))}
    </div>
  </div>
</section>

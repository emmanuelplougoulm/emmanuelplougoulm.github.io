---
// La stack en tableau périodique : une colonne par famille, des tuiles numérotées, le vrai logo.
import Logo from './Logo.astro';
import { getProfile } from '../data/profile';
import { getLang, ui } from '../i18n';
const lang = getLang(Astro.currentLocale);
const t = ui[lang].stack;
const { stackGroups } = getProfile(lang);
let n = 0;
const groups = stackGroups.map((g) => ({ ...g, items: g.items.map((t) => ({ ...t, n: ++n })) }));
---
<div class="stack" data-testid="stack">
  <div class="stack-head">
    <span class="mono">{t.title}</span>
    <p class="stack-intro">{t.intro(n, groups.length)}</p>
    <ul class="legend" aria-label={t.families}>
      {groups.map((g) => (
        <li><button type="button" class="fam" data-family={g.key} aria-pressed="false"><i></i>{g.name}<span>{g.items.length}</span></button></li>
      ))}
    </ul>
  </div>
  <ul class="sgrid">
    {groups.flatMap((g) => g.items.map((t) => (
      <li class="cell" data-family={g.key} style={`--n:${t.n}`} tabindex="0">
        <span class="cell-logo"><Logo tech={t} /></span>
        <span class="cell-name">{t.label}</span>
        <span class="cell-meta"><span class="cell-fam">{g.name}</span><span class="cell-note">{t.note}</span></span>
      </li>
    )))}
  </ul>
</div>
<script is:inline>
  (function () {
    var stack = document.querySelector('[data-testid="stack"]');
    if (!stack) return;
    var buttons = stack.querySelectorAll('.fam');
    function focus(key) {
      if (key) stack.setAttribute('data-focus', key); else stack.removeAttribute('data-focus');
      buttons.forEach(function (b) { b.setAttribute('aria-pressed', String(b.getAttribute('data-family') === key)); });
    }
    buttons.forEach(function (b) {
      var key = b.getAttribute('data-family');
      b.addEventListener('mouseenter', function () { if (!stack.dataset.locked) focus(key); });
      b.addEventListener('mouseleave', function () { if (!stack.dataset.locked) focus(null); });
      b.addEventListener('click', function () {
        var same = stack.dataset.locked === key;
        if (same) { delete stack.dataset.locked; focus(null); } else { stack.dataset.locked = key; focus(key); }
      });
    });
  })();
</script>

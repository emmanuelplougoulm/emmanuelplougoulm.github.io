---
import Icon from './Icon.astro';
import { links, posts } from '../data/profile';
const num = posts.length > 0 ? '05' : '04';
---
<section id="contact" class="contact">
  <div class="wrap">
    <span class="sec-num mono"><span class="ico"><Icon name="at" /></span>{num} / contact</span>
    <h2 style="margin-top:20px">Let's talk<br /><em>quality</em>.</h2>
    <div class="grid">
      <p>Testing, front-end quality, design systems, or a good idea. I usually reply within a couple of days.</p>
      <div class="contact-links">
        <a href={links.linkedin}><span class="lead-i"><Icon name="link" />LinkedIn</span> <span>in/emmanuel-plougoulm</span></a>
        <a href={links.github}><span class="lead-i"><Icon name="code" />GitHub</span> <span>emmanuelplougoulm</span></a>
        {links.email && <a href={`mailto:${links.email}`}><span class="lead-i"><Icon name="mail" />Email</span> <span>{links.email}</span></a>}
      </div>
    </div>
  </div>
</section>

---
import Icon from './Icon.astro';
import { links, cvFile, getProfile } from '../data/profile';
import { getLang, ui } from '../i18n';
const lang = getLang(Astro.currentLocale);
const t = ui[lang].contact;
const { posts } = getProfile(lang);
const num = posts.length > 0 ? '05' : '04';
---
<section id="contact" class="contact">
  <div class="wrap">
    <span class="sec-num mono"><span class="ico"><Icon name="at" /></span>{num} / contact</span>
    <h2 style="margin-top:20px">{t.title[0]}<br /><em>{t.title[1]}</em>{t.title[2]}</h2>
    <div class="grid">
      <p>{t.text}</p>
      <div class="contact-links">
        <a href={links.linkedin}><span class="lead-i"><Icon name="linkedin" />LinkedIn</span> <span>in/emmanuel-plougoulm</span></a>
        <a href={links.github}><span class="lead-i"><Icon name="code" />GitHub</span> <span>emmanuelplougoulm</span></a>
        <a href={cvFile[lang]} download><span class="lead-i"><Icon name="download" />CV</span> <span>{t.cvNote}</span></a>
        {links.email && <a href={`mailto:${links.email}`}><span class="lead-i"><Icon name="mail" />Email</span> <span>{links.email}</span></a>}
      </div>
    </div>
  </div>
</section>

---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { posts } from '../data/profile';
---
{posts.length > 0 && (
  <section id="writing">
    <div class="wrap">
      <SectionHead num="04" slug="writing" icon="pen" intro="Longer versions of what I share on LinkedIn.">
        Notes from the <em>test suite</em>.
      </SectionHead>
      {posts.map((p) => (
        <a class="post" href={p.url}>
          <span class="when">{p.date}</span>
          <div><b>{p.title}</b><p>{p.summary}</p><div class="tags">{p.tags.map((t) => <span class="chip">{t}</span>)}</div></div>
          <span class="go mono">Read <Icon name="arrow" /></span>
        </a>
      ))}
    </div>
  </section>
)}

---
import Icon from './Icon.astro';
import { links } from '../data/profile';
interface Props { showWriting: boolean; current?: 'lab' }
const { showWriting, current } = Astro.props;
// Hors de l'accueil, les ancres pointent vers les sections de l'accueil.
const home = current ? '/' : '';
---
<header class="top">
  <div class="wrap">
    <a class="brand" href={current ? '/' : '#top'}>Emmanuel Plougoulm <span>/ SDET</span></a>
    <nav class="links" aria-label="Sections">
      <a href={`${home}#path`}>Path</a>
      <a href={`${home}#practice`}>Practice</a>
      <a href={`${home}#work`}>Work</a>
      <a href="/lab/" aria-current={current === 'lab' ? 'page' : undefined}>Lab</a>
      {showWriting && <a href={`${home}#writing`}>Writing</a>}
      <a href={`${home}#contact`}>Contact</a>
    </nav>
    <div class="read-progress" aria-hidden="true"></div>
    <div class="top-actions">
    {links.cv && <a class="cv-btn mono" href={links.cv} download aria-label="Download CV (PDF)"><Icon name="download" />CV</a>}
    <button class="theme mono a11y-btn" type="button" id="a11y" aria-pressed="false" aria-label="A11y: show the accessibility layer">A11y</button>
    <button class="theme mono" type="button" id="theme" aria-label="Toggle colour theme">Light / Dark</button>
    </div>
  </div>
</header>

---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import Stack from './Stack.astro';
import { getLang, ui } from '../i18n';
const t = ui[getLang(Astro.currentLocale)].practice;
const [d, c, q] = t.cols;
---
<section id="practice">
  <div class="wrap">
    <SectionHead num="02" slug="practice" icon="layers" intro={t.intro}>
      {t.title[0]}<em>{t.title[1]}</em>{t.title[2]}
    </SectionHead>
    <div class="cols">
      <article class="col">
        <div class="col-body">
          <span class="tag mono"><Icon name="eye" />{d.tag}</span>
          <h3>{d.h3}</h3>
          <p class="lead">{d.lead}</p>
          <ul>{d.items.map((i) => <li><Icon name="check" />{i}</li>)}</ul>
        </div>
        <div class="col-art"><div class="file">
          <div class="tabbar"><Icon name="file" /><b>{t.diffTab}</b><span class="dots"><span></span><span></span><span></span></span></div>
          <div class="diff" role="img" aria-label={t.diffAria}>
            <div class="shot"><span class="lbl">{t.baseline}</span><div class="h"></div><div class="l"></div><div class="l s"></div><div class="b"></div></div>
            <div class="shot actual"><span class="lbl">{t.actual}</span><div class="h"></div><div class="l"></div><div class="l s"></div><div class="b"></div><div class="hit"></div><span class="tagdiff">DIFF</span></div>
            <span class="diff-note">{t.diffNote}</span>
          </div>
        </div></div>
      </article>
      <article class="col">
        <div class="col-body">
          <span class="tag mono"><Icon name="code" />{c.tag}</span>
          <h3>{c.h3}</h3>
          <p class="lead">{c.lead}</p>
          <ul>{c.items.map((i) => <li><Icon name="check" />{i}</li>)}</ul>
        </div>
        <div class="col-art"><div class="file">
          <div class="tabbar"><Icon name="file" /><b>checkout.spec.ts</b><span class="dots"><span></span><span></span><span></span></span></div>
<pre class="code" tabindex="0" aria-label={t.codeAria}><span class="k">test</span>(<span class="s">'checkout keeps the cart'</span>, <span class="k">async</span> ({'{'} <span class="f">cart</span>, <span class="f">checkout</span> {'}'}) =&gt; {'{'}
  <span class="k">await</span> cart.<span class="f">add</span>(<span class="s">'Blue T-shirt'</span>);
  <span class="k">await</span> checkout.<span class="f">open</span>();
  <span class="k">await</span> <span class="f">expect</span>(checkout.lines)
    .<span class="f">toHaveCount</span>(<span class="s">1</span>);
{'}'});</pre>
        </div></div>
      </article>
      <article class="col">
        <div class="col-body">
          <span class="tag mono"><Icon name="shield" />{q.tag}</span>
          <h3>{q.h3}</h3>
          <p class="lead">{q.lead}</p>
          <ul>{q.items.map((i) => <li><Icon name="check" />{i}</li>)}</ul>
        </div>
        <div class="col-art"><div class="file">
          <div class="tabbar"><Icon name="file" /><b>trust.feature</b><span class="dots"><span></span><span></span><span></span></span></div>
<pre class="code" tabindex="0" aria-label={t.gherkinAria}><span class="k">Feature:</span> Trustworthy interfaces

  <span class="k">Scenario:</span> A change reaches users
    <span class="k">Given</span> a pull request on main
    <span class="k">When</span> the suite runs in CI
    <span class="k">Then</span> flows, pixels and a11y pass
    <span class="k">And</span> <span class="c">only then</span> it ships</pre>
        </div></div>
      </article>
    </div>
    <Stack />
  </div>
</section>
